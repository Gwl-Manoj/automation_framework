<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Automation Test Suite" parallel="false">

    <listeners>
        <listener class-name="com.automation.utils.ExtentReportManager"/>
    </listeners>

    <test name="UI Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.tests.SubscriptionTest"/>
        </classes>
    </test>
</suite>